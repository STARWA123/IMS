generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Stage {
  APPLIED
  ASSESSMENT
  FIRST_INTERVIEW
  SECOND_INTERVIEW
  THIRD_INTERVIEW
  HR_INTERVIEW
  OFFER
  REJECTED
}

enum Status {
  PENDING
  COMPLETED
  FAILED
}

enum EventType {
  APPLIED
  ASSESSMENT_COMPLETED
  FIRST_INTERVIEW_COMPLETED
  SECOND_INTERVIEW_COMPLETED
  THIRD_INTERVIEW_COMPLETED
  HR_INTERVIEW_COMPLETED
  OFFER_RECEIVED
  REJECTED
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id                 String      @id @default(cuid())
  username           String      @unique
  displayName        String
  passwordHash       String
  role               UserRole    @default(USER)
  isActive           Boolean     @default(true)
  mustChangePassword Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  workspaces         Workspace[]
  sessions           Session[]

  @@index([createdAt])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id          String    @id @default(cuid())
  ownerId     String?
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  companies   Company[]

  @@index([ownerId, updatedAt])
  @@index([updatedAt])
}

model Company {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  jobs        Job[]

  // The composite key lets Job enforce that companyId and workspaceId
  // always identify a company in the same workspace.
  @@unique([id, workspaceId])
  @@index([workspaceId, name])
}

model Job {
  id             String          @id @default(cuid())
  workspaceId    String
  companyId      String
  jobName        String
  baseLocation   String
  jobUrl         String?
  stage          Stage           @default(APPLIED)
  status         Status          @default(PENDING)
  remark         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  company        Company        @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Cascade)
  timelineEvents TimelineEvent[]

  @@index([workspaceId, updatedAt])
  @@index([companyId])
  @@index([stage])
}

model TimelineEvent {
  id        String    @id @default(cuid())
  jobId     String
  eventType EventType
  eventDate DateTime
  remark    String?
  createdAt DateTime  @default(now())
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([jobId, eventDate])
  @@index([eventDate])
}
