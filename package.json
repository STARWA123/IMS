{
  "name": "offertrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:prepare": "tsx scripts/prepare-database.ts",
    "db:deploy": "tsx scripts/prepare-database.ts && prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:jobs": "tsx scripts/seed-job-test-data.ts",
    "db:init": "tsx scripts/prepare-database.ts && prisma migrate deploy && tsx prisma/seed.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "db:backup": "tsx scripts/create-local-backup.ts",
    "test:workspace": "tsx scripts/test-workspace-module.ts",
    "test:jobs": "tsx scripts/test-job-module.ts",
    "test:company-view": "tsx scripts/test-company-view-module.ts",
    "test:kanban": "tsx scripts/test-kanban-module.ts",
    "test:timeline": "tsx scripts/test-timeline-module.ts",
    "test:dashboard": "tsx scripts/test-dashboard-module.ts",
    "test:data-management": "tsx scripts/test-data-management-module.ts",
    "test:job-import": "tsx scripts/test-job-import-module.ts",
    "test:auth": "tsx scripts/test-auth-module.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "better-sqlite3": "^12.0.0",
    "exceljs": "^4.4.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  }
}
