# First deployment only. Choose values locally on the server; never commit the real file.
OFFERTRACK_ADMIN_USERNAME=admin
OFFERTRACK_ADMIN_DISPLAY_NAME=Administrator
OFFERTRACK_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Use false only during the temporary IP-over-HTTP stage. Change to true after HTTPS is enabled.
OFFERTRACK_SECURE_COOKIES=false

# Production host persistence. Local development can omit these two values.
OFFERTRACK_DATA_DIR=/opt/offertrack-prod/data
OFFERTRACK_BACKUP_DIR=/opt/offertrack-prod/backups
